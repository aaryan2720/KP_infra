# ==========================================
# K.P. Infrastructure - SMTP Configuration
# ==========================================

# SMTP Host (e.g. smtp.gmail.com, smtp.hostinger.com, smtp.office365.com)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# Set to true for port 465 (SSL), false for port 587 (TLS)
SMTP_SECURE=true

# SMTP Username / Sender email
SMTP_USER=your-email@gmail.com

# SMTP Password / App Password (For Gmail, generate an "App Password" in Google Account Security)
SMTP_PASS=your-app-password-here

# Where you want to receive enquiry emails (can be multiple separated by comma)
CONTACT_RECEIVER_EMAIL=info@kpinfrastructure.com

# Optional display name / sender format
CONTACT_FROM_EMAIL="K.P. Infrastructure Website" <your-email@gmail.com>
